# Any ONE text provider is enough. With none set, the app runs in offline mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: HuggingFace token for text-to-image (FLUX.1-schnell) AND text-to-video (Wan 2.2)
HF_TOKEN=
# Text-to-video models (GEMINI_API_KEY above also enables Gemini Omni Flash video)
# GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
# HF_VIDEO_MODEL=Wan-AI/Wan2.2-TI2V-5B
# FREE text-to-video (CogVideoX-Flash, ~5 videos/day, no card): sign up at https://aiapi-pro.com/register
NOVAI_API_KEY=
# NOVAI_VIDEO_MODEL=cogvideox-flash
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-3.8-flash
# Seconds to wait for a text-model reply before trying the next Gemini model (default 180)
# LLM_TIMEOUT=180
POLLINATIONS_API_KEY=
